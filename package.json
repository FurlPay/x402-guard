{
  "name": "@furlpay/x402-guard",
  "version": "0.2.0",
  "description": "Facilitator-layer hardening for x402 agentic payments \u2014 closes all five flaw classes from arXiv:2605.30998: cross-resource substitution, duplicate-settlement race, allowance overdraft, denial of settlement, hidden-compute pricing",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "harness"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js"
    },
    "./mandate": {
      "types": "./dist/mandate.d.ts",
      "import": "./dist/mandate.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test",
    "harness": "node harness/run.mjs",
    "harness:json": "node harness/run.mjs --json",
    "sweep": "node harness/sweep.mjs",
    "test:redis": "node --test test/redis-integration.test.mjs",
    "mp": "node harness/multiprocess.mjs"
  },
  "keywords": [
    "x402",
    "agentic-payments",
    "facilitator",
    "stablecoin",
    "security",
    "solana",
    "usdc",
    "webhooks"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/furlpay/x402-guard"
  },
  "homepage": "https://furlpay.com",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "5.5.3",
    "@types/node": "20.14.10"
  },
  "peerDependencies": {
    "@types/node": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  }
}
